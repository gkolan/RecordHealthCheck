# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json
.claude/
/CLAUDE.md
.playwright-mcp/

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated and local-only reports
/reports/
releases/**/reports/tmp/
test-results/
playwright-report/
*.junit.xml
*.tap

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env
.env.*
!.env.example

# Internal / local-only files — kept on your machine, never published.
# Remove an entry below if you decide you DO want it in the public repo.
/docs/development/
/spec/
/releases/
.backups/
tasks/
slides_build/
*.pptx
docs/slides/
docs/examples/non-profit-cloud/
project-homepage.html
project-homepage copy.html
PUBLISHING.md

# Standalone interactive HTML pages (not part of the published docs)
docs/interactive/

# Stray screenshots / build images (not referenced by docs)
build-record-health-check-mobile.png

# Engineering audit reports (living backlog is in tasks/)
docs/audits/

# Point-in-time review write-ups; they cite local-only docs/spec/ and bugs/ notes
docs/review/
docs/reviews/

# Maintainer execution plans and deferred-feature archives (local only)
docs/enhancements/
force-app/deferred/

# Dev iteration notes superseded by design spec + CHANGELOG
docs/reference/record-health-check-ui-changes-2026-06.md

# Engineering hardening tracker (backlog, effort sizing, status — maintainer only)
docs/reference/code-quality-and-hardening-guide.md

# CI / IDE artifacts
code-analyzer.html
.cursor/
.vscode/
*.tgz

# Doc-template scaffolding / boilerplate — not published with the project.
# (Note: .github/ISSUE_TEMPLATE/ and pull_request_template.md are functional
#  GitHub config and are intentionally NOT ignored.)
templates/
docs/_templates/
**/_TEMPLATE.*

# Maintainer doc-generation / authoring tooling (one-off Python scripts).
# Local helper scripts — kept local, not published with the project.
scripts/*
# Release-gate scripts used by package.json and CI are public and tracked.
!scripts/release/
!scripts/release/**
# Exception: the metadata validator is a release-gate dependency referenced by
# .github/workflows/salesforce-validate.yml and the V2 upgrade docs, so it must
# be tracked. Everything else under scripts/ stays local.
!scripts/apex/
scripts/apex/*
!scripts/apex/validateMetadata.apex

# Internal planning / roadmap docs — kept local, not published with the project.
docs/spec/
docs/reference/product-roadmap.md
docs/reference/label-simplification-plan.md
docs/guides/cli-commands.md
docs/demo/
docs/demo-account-health-check-component.md

# Internal bug write-ups — kept local, not published with the project.
bugs/

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Local recycle bin — superseded material kept on disk but never tracked
recycle-bin/

# Legacy GitHub Wiki source; public guidance is maintained under docs/.
/wiki/

# Personal, portable scratch-org setup kit — never tracked; meant to be movable out of the repo.
/scratch-org-setup/

# Jekyll/GitHub Pages scaffold for docs/ — kept locally, not maintaining a published static site.
docs/_config.yml
docs/index.html
docs/_layouts/
docs/assets/css/style.css
