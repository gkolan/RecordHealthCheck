<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CountOperator__c</fullName>
    <label>Count Must Be</label>
    <description
  >Applicability gate only - not part of the pass/fail logic. How the count from Applies When Count Query Matches is compared to Count Value. The check runs only when this comparison is true. Required when "Applies To" is "Only records where a count query matches".</description>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Equals</fullName>
                <default>false</default>
                <label>Equal to</label>
            </value>
            <value>
                <fullName>NotEquals</fullName>
                <default>false</default>
                <label>Not equal to</label>
            </value>
            <value>
                <fullName>GreaterThan</fullName>
                <default>false</default>
                <label>Greater than</label>
            </value>
            <value>
                <fullName>GreaterThanOrEqual</fullName>
                <default>false</default>
                <label>At least</label>
            </value>
            <value>
                <fullName>LessThan</fullName>
                <default>false</default>
                <label>Less than</label>
            </value>
            <value>
                <fullName>LessThanOrEqual</fullName>
                <default>false</default>
                <label>At most</label>
            </value>
        </valueSetDefinition>
    </valueSet>
        <inlineHelpText
  >Part of the applicability gate, not the main check. Example: "Greater than" with an Count Value of 0 runs the check only when at least one row matches.</inlineHelpText>
    <required>false</required>
</CustomField>
