  @TestVisible
  private RecordHealthCheckConfigService configService = new RecordHealthCheckConfigService();
  private RecordHealthCheckFormulaEvaluator formulaEvaluator = new RecordHealthCheckFormulaEvaluator();
  private RecordHealthCheckSoqlEvaluator soqlEvaluator = new RecordHealthCheckSoqlEvaluator();
  private RecordHealthCheckCompareQueriesEvaluator compareQueriesEvaluator = new RecordHealthCheckCompareQueriesEvaluator();
  private RecordHealthCheckApexEvaluator apexEvaluator = new RecordHealthCheckApexEvaluator();
  @TestVisible
  private static Map<String, RecordHealthCheckResult> transactionResultCache = new Map<String, RecordHealthCheckResult>();
  @TestVisible
  private RecordHealthCheckResult validationResultOverride;

  /**
   * Routes a single check to the correct evaluator and returns exactly one
   * RecordHealthCheckResult. Catchable failures become result statuses; Apex
   * governor-limit exceptions remain uncatchable platform behavior.
   * configName is required and is used server-side to confirm the rule belongs
   * to the named Check Set and that the Check Set is active, preventing a caller
   * from evaluating arbitrary or inactive rules by DeveloperName alone.
   */
  public RecordHealthCheckResult evaluate(
    String configName,
    String checkDeveloperName,
    Id recordId
  ) {
    return evaluate(configName, checkDeveloperName, recordId, null);
  }

  /**
   * `onBehalfOfUserId` is a log tag only; the facade's run() logging already
   * records it, so this overload delegates to the 4-arg evaluate.
   */
  public RecordHealthCheckResult evaluate(
    String configName,
    String checkDeveloperName,
    Id recordId,
    String runId,
    Id onBehalfOfUserId
  ) {
    return evaluate(configName, checkDeveloperName, recordId, runId);
  }

  /**
   * runId is a correlation id generated by the LWC (one per page load / run) and
   * threaded through so every log line for this user interaction shares a key.
   * All logging routes through RecordHealthCheckLogger, which also stamps the
   * running user id on each line.
   */
  public RecordHealthCheckResult evaluate(
    String configName,
    String checkDeveloperName,
    Id recordId,
    String runId
  ) {
    runId = RecordHealthCheckLogger.normalizeIdentifier(runId, 120);
    configName = RecordHealthCheckLogger.normalizeIdentifier(configName, 80);
    checkDeveloperName = RecordHealthCheckLogger.normalizeIdentifier(
      checkDeveloperName,
      80
    );
    RecordHealthCheckLogger logger = new RecordHealthCheckLogger(
      runId,
      configName,
      recordId
    );
    Long startMs = System.currentTimeMillis();

    // do NOT reset the FormulaEval budget here. Salesforce's 100-call
    // The platform FormulaEval limit is transaction-wide and only clears at the
    // end of the Apex transaction, not per check, so the framework counter must
    // accumulate across the whole transaction too. Resetting it per check would
    // let any caller that loops evaluate() in one transaction (Flow, batch,
    // anonymous Apex) drive the framework count back to zero while the real
    // platform count keeps climbing — the guard would then green-light the call
    // that hits the uncatchable governor limit.

    RecordHealthCheckResult result = new RecordHealthCheckResult();
    result.checkDeveloperName = checkDeveloperName;

    try {
      if (recordId == null) {
        result.status = 'UNABLE_TO_EVALUATE';
        result.reasonCode = 'NO_RECORD_CONTEXT';
        result.message = 'A record id is required to evaluate this check.';
        logger.warn(checkDeveloperName, 'NO_RECORD_CONTEXT', null);
      } else {
        result = doEvaluate(
          configName,
          checkDeveloperName,
          recordId,
          new Set<String>(),
          logger
        );
      }
    } catch (Exception ex) {
      result.status = 'ERROR';
      result.reasonCode = 'APEX_EVALUATOR_ERROR';
      result.message = 'An unexpected error occurred. Contact your administrator.';
      result.detailMessage = ex.getMessage();
      logger.error(checkDeveloperName, 'UNHANDLED_EXCEPTION', null, ex);
    }

    if (result.durationMs == null) {
      result.durationMs = System.currentTimeMillis() - startMs;
    }

    // the result cache exists ONLY to memoize a shared prerequisite within
    // a single top-level evaluation (dependency recursion in doEvaluate). Clearing
    // it here, once the top-level evaluation has finished, means a later
    // run()/evaluate() in the same Apex transaction (Flow, batch, anonymous Apex)
    // starts fresh instead of returning this run's stale status/values. Memoization
    // within the call is untouched, and the LWC is unaffected (each evaluateCheck
    // is its own tx).
    transactionResultCache.clear();

    return result;
  }

  // ─── Core routing ─────────────────────────────────────────────────────────

  @TestVisible
  private RecordHealthCheckResult doEvaluate(
    String configName,
    String checkDeveloperName,
    Id recordId,
    Set<String> visitedChain,
    RecordHealthCheckLogger logger
  ) {
    String cacheKey =
      configName +
      '|' +
      String.valueOf(recordId) +
      '|' +
      checkDeveloperName;
    if (transactionResultCache.containsKey(cacheKey)) {
      return copyResult(transactionResultCache.get(cacheKey));
    }
    RecordHealthCheckResult result = doEvaluateUncached(
      configName,
      checkDeveloperName,
      recordId,
      visitedChain,
      logger
    );
    transactionResultCache.put(cacheKey, copyResult(result));
    return result;
  }

  @TestVisible
  private RecordHealthCheckResult copyResult(RecordHealthCheckResult source) {
    RecordHealthCheckResult copy = new RecordHealthCheckResult();
    copy.checkDeveloperName = source.checkDeveloperName;
    copy.label = source.label;
    copy.status = source.status;
    copy.severity = source.severity;
    copy.message = source.message;
    copy.actualValue = source.actualValue;
    copy.expectedValue = source.expectedValue;
    copy.expectedValueLabel = source.expectedValueLabel;
    copy.actualValueDetail = source.actualValueDetail;
    copy.expectedValueDetail = source.expectedValueDetail;
    copy.actualValueSource = source.actualValueSource;
    copy.expectedValueSource = source.expectedValueSource;
    copy.detailMessage = source.detailMessage;
    copy.adminDetailMessage = source.adminDetailMessage;
    copy.actionLabel = source.actionLabel;
    copy.actionUrl = source.actionUrl;
    copy.fixInstructions = source.fixInstructions;
    copy.reasonCode = source.reasonCode;
    copy.priority = source.priority;
    copy.durationMs = source.durationMs;
    copy.evaluatorType = source.evaluatorType;
    return copy;
  }

  private RecordHealthCheckResult doEvaluateUncached(
    String configName,
    String checkDeveloperName,
    Id recordId,
    Set<String> visitedChain,
    RecordHealthCheckLogger logger
  ) {
    Boolean showDiagnostics = false;

    // 1. Load rule — scoped to the named Check Set. Include inactive so we can
    // tell RULE_INACTIVE apart from RULE_NOT_FOUND (missing / wrong Check Set).
    Record_Health_Check_Rule__mdt rule = configService.loadRule(
      checkDeveloperName,
      configName,
      false
    );
    if (rule == null) {
      logger.warn(checkDeveloperName, 'RULE_NOT_FOUND', null);
      RecordHealthCheckResult r = new RecordHealthCheckResult();
      r.checkDeveloperName = checkDeveloperName;
      r.status = 'UNABLE_TO_EVALUATE';
      r.reasonCode = 'RULE_NOT_FOUND';
      r.message = 'This rule was not found.';
      return r;
    }
    if (rule.IsActive__c != true) {
      logger.warn(checkDeveloperName, 'RULE_INACTIVE', null);
      RecordHealthCheckResult r = new RecordHealthCheckResult();
      r.checkDeveloperName = checkDeveloperName;
      r.label = rule.CheckTitle__c;
      r.priority = rule.EvaluationOrder__c;
      r.status = 'UNABLE_TO_EVALUATE';
      r.reasonCode = 'RULE_INACTIVE';
      r.message = 'This rule is inactive.';
      return r;
    }

    // 1a. Validate the parent Check Set is still active and targets the right object.
    // Also extract ShowDiagnostics__c for this run.
    SObject checkSetRef = rule.getSObject('Record_Health_Check_Set__r');
    CheckSetContextOutcome checkSetOutcome = validateCheckSetContext(
      checkSetRef,
      configName,
      checkDeveloperName,
      recordId
    );
    showDiagnostics = checkSetOutcome.showDiagnostics;
    if (checkSetOutcome.result != null) {
      // CONFIG_INACTIVE or OBJECT_MISMATCH — surfaced here so all logging stays
      // in one layer (validateCheckSetContext itself does not log).
      logger.warn(
        checkDeveloperName,
        'CHECK_SET_CONTEXT_INVALID',
        new Map<String, Object>{
          'reasonCode' => checkSetOutcome.result.reasonCode
        }
      );
      return checkSetOutcome.result;
    }

    logger.debug(
      checkDeveloperName,
      'START',
      new Map<String, Object>{
        'type' => rule.EvaluationType__c,
        'showDiagnostics' => showDiagnostics
      }
    );

    // server-side PrerequisiteRule__c gate — mirrors LWC client-side logic
    if (String.isNotBlank(rule.PrerequisiteRule__c)) {
      String prereqName = rule.PrerequisiteRule__c.trim();
      if (visitedChain.contains(prereqName)) {
        RecordHealthCheckResult r = new RecordHealthCheckResult();
        r.checkDeveloperName = checkDeveloperName;
        r.label = rule.CheckTitle__c;
        r.priority = rule.EvaluationOrder__c;
        r.status = 'UNABLE_TO_EVALUATE';
        r.reasonCode = 'CIRCULAR_DEPENDENCY';
        r.message = 'Circular dependency with "' + prereqName + '".';
        return applyCheckSetFlags(r, showDiagnostics);
      }
      Set<String> nextVisited = new Set<String>(visitedChain);
      nextVisited.add(checkDeveloperName);
      RecordHealthCheckResult prereqResult = doEvaluate(
        configName,
        prereqName,
        recordId,
        nextVisited,
        logger
      );
      if (prereqResult.status != 'PASS') {
        if (prereqResult.reasonCode == 'CIRCULAR_DEPENDENCY') {
          RecordHealthCheckResult circular = new RecordHealthCheckResult();
          circular.checkDeveloperName = checkDeveloperName;
          circular.label = rule.CheckTitle__c;
          circular.priority = rule.EvaluationOrder__c;
          circular.status = 'UNABLE_TO_EVALUATE';
          circular.reasonCode = 'CIRCULAR_DEPENDENCY';
          circular.message = 'Circular dependency with "' + prereqName + '".';
          return applyCheckSetFlags(circular, showDiagnostics);
        }
        logger.debug(
          checkDeveloperName,
          'DEPENDENCY_NOT_PASSED',
          new Map<String, Object>{
            'prereq' => prereqName,
            'prereqStatus' => prereqResult.status
          }
        );
        RecordHealthCheckResult r = new RecordHealthCheckResult();
        r.checkDeveloperName = checkDeveloperName;
        r.label = rule.CheckTitle__c;
        r.priority = rule.EvaluationOrder__c;
        r.status = 'SKIPPED';
        r.reasonCode = 'DEPENDENCY_NOT_PASSED';
        r.message = 'Skipped because "' + prereqName + '" did not pass.';
        return applyCheckSetFlags(r, showDiagnostics);
      }
    }

    // 2. Runtime metadata validation
    RecordHealthCheckResult validationResult = validationResultOverride != null
      ? validationResultOverride
      : configService.validateRuleForEvaluation(rule);
    if (validationResult != null) {
      logger.warn(
        checkDeveloperName,
        'METADATA_INVALID',
        new Map<String, Object>{
          'reasonCode' => validationResult.reasonCode,
          'detail' => validationResult.detailMessage
        }
      );
      return applyCheckSetFlags(validationResult, showDiagnostics);
    }

    // 3. Load the base record (WITH USER_MODE enforces FLS for the running user).
    SObject record;
    try {
      record = loadRecord(recordId, rule);
    } catch (Exception ex) {
      logger.warn(
        checkDeveloperName,
        'RECORD_NOT_ACCESSIBLE',
        new Map<String, Object>{ 'detail' => ex.getMessage() }
      );
      RecordHealthCheckResult r = new RecordHealthCheckResult();
      r.checkDeveloperName = checkDeveloperName;
      r.label = rule.CheckTitle__c;
      r.priority = rule.EvaluationOrder__c;
      r.status = 'UNABLE_TO_EVALUATE';
      r.reasonCode = 'RECORD_NOT_ACCESSIBLE';
      r.message = 'The record could not be accessed. Contact your administrator.';
      r.detailMessage = ex.getMessage();
      return applyCheckSetFlags(r, showDiagnostics);
    }
    if (record == null) {
      logger.warn(
        checkDeveloperName,
        'RECORD_NOT_ACCESSIBLE',
        new Map<String, Object>{ 'detail' => 'query returned no rows' }
      );
      RecordHealthCheckResult r = new RecordHealthCheckResult();
      r.checkDeveloperName = checkDeveloperName;
      r.label = rule.CheckTitle__c;
      r.priority = rule.EvaluationOrder__c;
      r.status = 'UNABLE_TO_EVALUATE';
      r.reasonCode = 'RECORD_NOT_ACCESSIBLE';
      r.message = 'The record could not be accessed. Contact your administrator.';
      return applyCheckSetFlags(r, showDiagnostics);
    }

    // 4. Applicability gate (server-side, runs before every evaluator)
    RecordHealthCheckResult applicabilityResult = checkApplicability(
      rule,
      recordId,
      record
    );
    if (applicabilityResult != null) {
      logger.debug(
        checkDeveloperName,
        'APPLICABILITY_GATE',
        new Map<String, Object>{
          'status' => applicabilityResult.status,
          'reasonCode' => applicabilityResult.reasonCode
        }
      );
      // An applicability skip / unable result may carry a UnableToEvaluateMessage__c
      // template with {!record.FieldName} tokens; resolve them here too (the record is
      // already loaded) so tokens never reach the UI.
      resolveResultMessage(applicabilityResult, rule, record);
      return applyCheckSetFlags(applicabilityResult, showDiagnostics);
    }

    logger.debug(
      checkDeveloperName,
      'APPLICABILITY_PASS',
      new Map<String, Object>{ 'mode' => rule.ApplicabilityMode__c }
    );

    // 5. Route to evaluator
    RecordHealthCheckResult evalResult = routeEvaluator(rule, recordId, record);

    // 6. Resolve merge fields in result messages; a bad token must not change status.
    resolveEvalResultMessage(evalResult, rule, record);

    // 6b. Guided remediation: a FAIL may carry a read-only deep link the admin
    // authored per rule. Populated only on FAIL (remediation is meaningless on a
    // pass, and a non-determinate status may not have a loaded record to resolve
    // tokens against). The URL is token-resolved against the record and then
    // sanitized before it can reach the UI as an href.
    populateRemediationAction(evalResult, rule, record);

    // 7. Result logging (severity-mapped) and adminDetailMessage propagation.
    // PASS/SKIPPED are routine (DEBUG); FAIL is noteworthy (INFO); anything
    // else (UNABLE_TO_EVALUATE/ERROR) is a problem worth surfacing (WARN).
    Map<String, Object> resultFields = new Map<String, Object>{
      'status' => evalResult.status,
      'severity' => evalResult.severity,
      'reasonCode' => evalResult.reasonCode,
      'durationMs' => evalResult.durationMs
    };
    if (String.isNotBlank(evalResult.detailMessage)) {
      resultFields.put('detail', evalResult.detailMessage);
    }
    if (evalResult.status == 'PASS' || evalResult.status == 'SKIPPED') {
      logger.debug(checkDeveloperName, 'RESULT', resultFields);
    } else if (evalResult.status == 'FAIL') {
      logger.info(checkDeveloperName, 'RESULT', resultFields);
    } else {
      logger.warn(checkDeveloperName, 'RESULT', resultFields);
    }

    return applyCheckSetFlags(evalResult, showDiagnostics);
  }

  // Copies detailMessage → adminDetailMessage when debug mode is on so the LWC
  // can surface it to admins without ever exposing raw internals in production.
  @TestVisible
  private RecordHealthCheckResult applyShowDiagnostics(
    RecordHealthCheckResult result,
    Boolean showDiagnostics
  ) {
    if (
      showDiagnostics &&
      RecordHealthCheckAccess.canViewDebugDetails() &&
      String.isNotBlank(result.detailMessage)
    ) {
      result.adminDetailMessage = result.detailMessage;
    } else {
      result.adminDetailMessage = null;
    }
    return result;
  }

  private RecordHealthCheckResult applyCheckSetFlags(
    RecordHealthCheckResult result,
    Boolean showDiagnostics
  ) {
    applyLwcWireFields(result);
    applyPassesWhenEntitlement(result);
    applyValueSourceDetail(result);
    return applyShowDiagnostics(result, showDiagnostics);
  }

  @TestVisible
  private RecordHealthCheckResult applyLwcWireFields(
    RecordHealthCheckResult result
  ) {
    if (String.isNotBlank(result.severity)) {
      result.severity = RecordHealthCheckConstants.toLwcSeverity(
        result.severity
      );
    }
    if (String.isNotBlank(result.evaluatorType)) {
      result.evaluatorType = RecordHealthCheckConstants.toLwcEvaluatorType(
        result.evaluatorType
      );
    }
    return result;
  }

  // A Formula check with no display formulas echoes its raw pass/fail condition
  // as a "Passes when" line on the Expected side. That is a technical explanation
  // (formula text, field API names), not business evidence, so it is Advanced-tier
  // only: without Record_Health_Check_View_Details the line is cleared and the
  // business user sees the failure message (plus any display-formula Found/Expected
  // chips, which stay ungated). Only the raw-condition echo is gated — an Expected
  // value produced by DisplayExpectedFormula__c carries no expectedValueLabel and is
  // left untouched.
  @TestVisible
  private RecordHealthCheckResult applyPassesWhenEntitlement(
    RecordHealthCheckResult result
  ) {
    if (
      result.expectedValueLabel == RecordHealthCheckResult.PASSES_WHEN_LABEL &&
      !RecordHealthCheckAccess.canViewDetails()
    ) {
      result.expectedValue = null;
      result.expectedValueLabel = null;
    }
    return result;
  }

  // Renders the structured value source the evaluators captured into the two
  // public *Detail strings, then gates them on Record_Health_Check_View_Details.
  // Unlike debug detail, value source is not tied to ShowDiagnostics__c. When the user
  // lacks Record_Health_Check_View_Details the *Detail strings stay null.
  @TestVisible
  private RecordHealthCheckResult applyValueSourceDetail(
    RecordHealthCheckResult result
  ) {
    if (RecordHealthCheckAccess.canViewDetails()) {
      result.actualValueDetail = RecordHealthCheckValueSource.render(
        result.actualValueSource
      );
      result.expectedValueDetail = RecordHealthCheckValueSource.render(
        result.expectedValueSource
      );
    } else {
      result.actualValueDetail = null;
      result.expectedValueDetail = null;
    }
    return result;
  }

  @TestVisible
  private RecordHealthCheckResult routeEvaluator(
    Record_Health_Check_Rule__mdt rule,
    Id recordId,
    SObject record
  ) {
    if (rule.EvaluationType__c == 'FORMULA') {
      return formulaEvaluator.evaluate(rule, recordId, record);
    }
    if (rule.EvaluationType__c == 'QUERY') {
      return soqlEvaluator.evaluate(rule, recordId, record);
    }
    if (rule.EvaluationType__c == 'APEX') {
      return apexEvaluator.evaluate(rule, recordId, record);
    }
    if (rule.EvaluationType__c == 'COMPARE_TWO_QUERIES') {
      return compareQueriesEvaluator.evaluate(rule, recordId, record);
    }

    // Unrecognized — config service should have caught this, but guard defensively
    RecordHealthCheckResult result = new RecordHealthCheckResult();
    result.checkDeveloperName = rule.DeveloperName;
    result.label = rule.CheckTitle__c;
    result.priority = rule.EvaluationOrder__c;
    result.status = 'UNABLE_TO_EVALUATE';
    result.reasonCode = 'INVALID_CHECK_TYPE';
    result.message = 'This Evaluation Type is not recognized.';
    return result;
  }

  // ─── Applicability gate ────────────────────────────────────

  @TestVisible
  private class CheckSetContextOutcome {
    public Boolean showDiagnostics = false;
    public RecordHealthCheckResult result;
  }

  @TestVisible
  private CheckSetContextOutcome validateCheckSetContext(
    SObject checkSetRef,
    String configName,
    String checkDeveloperName,
    Id recordId
  ) {
    CheckSetContextOutcome outcome = new CheckSetContextOutcome();
    if (checkSetRef == null) {
      // a null Check Set relationship must NOT proceed as if the set were
      // active and object-matched (that would bypass IsActive__c / ObjectApiName__c
      // enforcement). loadRule only returns a rule whose set relationship is
      // populated, so reaching here is an anomaly — surface it as a config error.
      RecordHealthCheckResult result = new RecordHealthCheckResult();
      result.checkDeveloperName = checkDeveloperName;
      result.status = 'UNABLE_TO_EVALUATE';
      result.reasonCode = 'CONFIG_NOT_FOUND';
      result.message = 'The health check configuration could not be loaded.';
      outcome.result = result;
      return outcome;
    }

    outcome.showDiagnostics = checkSetRef.get('ShowDiagnostics__c') == true;
    if (checkSetRef.get('IsActive__c') == false) {
      // Logged by the caller (doEvaluate) so all logging lives in one layer.
      RecordHealthCheckResult result = new RecordHealthCheckResult();
      result.checkDeveloperName = checkDeveloperName;
      result.status = 'UNABLE_TO_EVALUATE';
      result.reasonCode = 'CONFIG_INACTIVE';
      result.message = 'Check Set "' + configName + '" is inactive.';
      outcome.result = result;
      return outcome;
    }

    String baseObj = (String) checkSetRef.get('ObjectApiName__c');
    String recordObj = RecordHealthCheckDescribeCache.objectApiName(recordId);
    if (String.isNotBlank(baseObj) && !recordObj.equalsIgnoreCase(baseObj)) {
      // Logged by the caller (doEvaluate) so all logging lives in one layer.
      RecordHealthCheckResult result = new RecordHealthCheckResult();
      result.checkDeveloperName = checkDeveloperName;
      result.status = 'UNABLE_TO_EVALUATE';
      result.reasonCode = 'OBJECT_MISMATCH';
      result.message =
        'Check Set is for "' +
        baseObj +
        '", but this record is "' +
        recordObj +
        '".';
      outcome.result = result;
    }
    return outcome;
  }

  /**
   * Returns null if the check should proceed.
   * Returns a SKIPPED result if the gate evaluates false.
   * Returns an UNABLE_TO_EVALUATE result if the gate cannot be safely evaluated.
   */
  @TestVisible
  private RecordHealthCheckResult checkApplicability(
    Record_Health_Check_Rule__mdt rule,
    Id recordId,
    SObject record
  ) {
    if (
      rule.ApplicabilityMode__c == 'ALL_RECORDS' ||
      rule.ApplicabilityMode__c == null
    ) {
      return null;
    }

    if (rule.ApplicabilityMode__c == 'WHEN_FORMULA_TRUE') {
      String[] reasonCodeOut = new List<String>{ '' };
      Boolean applies = formulaEvaluator.evaluateApplicabilityFormula(
        rule.ApplicabilityFormula__c,
        record,
        reasonCodeOut
      );

      if (applies == null) {
        return buildUnableResult(
          rule,
          reasonCodeOut[0],
          'The applicability condition could not be evaluated.'
        );
      }
      if (!applies) {
        return buildSkippedResult(rule);
      }
      return null;
    }

    if (rule.ApplicabilityMode__c == 'WHEN_COUNT_QUERY_MATCHES') {
      return checkSoqlApplicability(rule, record);
    }

    return buildUnableResult(
      rule,
      'INVALID_CONFIG',
      'Unrecognized Applicability Mode: ' + rule.ApplicabilityMode__c
    );
  }

  @TestVisible
  private RecordHealthCheckResult checkSoqlApplicability(
    Record_Health_Check_Rule__mdt rule,
    SObject record
  ) {
    if (String.isBlank(rule.ApplicabilityCountQuery__c)) {
      return buildUnableResult(
        rule,
        'INVALID_SOQL_TEMPLATE',
        'Applicability SOQL is required when Applicability Mode is SOQL.'
      );
    }

    try {
      String boundSoql = soqlEvaluator.bindTokens(
        rule.ApplicabilityCountQuery__c,
        record
      );
      if (!RecordHealthCheckSoqlTemplate.isSingleCountQuery(boundSoql)) {
        return buildUnableResult(
          rule,
          'INVALID_SOQL_TEMPLATE',
          'Applicability SOQL must be a single COUNT() or COUNT(Id) query without GROUP BY.'
        );
      }
      if (rule.ApplicabilityCountThreshold__c == null) {
        return buildUnableResult(
          rule,
          'INVALID_CONFIG',
          'Applicability Comparison Value is required for SOQL applicability.'
        );
      }

      String safeSoql = RecordHealthCheckSoqlTemplate.prepareForExecution(
        boundSoql,
        1
      );
      List<SObject> rows = Database.query(safeSoql);

      Integer count;
      if (!rows.isEmpty() && rows[0] instanceof AggregateResult) {
        // COUNT(Id) / COUNT() with no alias → expr0. Named aliases (e.g. COUNT(Id) mycount)
        // return null for expr0 — surface a clear config error rather than silently treating as 0.
        // accept any alias by looking up the first populated field rather
        // than hardcoding 'expr0', which is absent when the admin names the alias.
        AggregateResult ar = (AggregateResult) rows[0];
        Map<String, Object> populated = ar.getPopulatedFieldsAsMap();
        Object val = populated.isEmpty() ? null : populated.values()[0];
        if (val == null) {
          return buildUnableResult(
            rule,
            'INVALID_SOQL_TEMPLATE',
            'Applicability SOQL aggregate returned no value. Ensure the SELECT clause contains a valid aggregate function such as COUNT(Id).'
          );
        }
        // an aggregate value that is not a whole number (or overflows
        // Integer) would throw an uncaught TypeException; surface it as a config
        // error instead so the check reports UNABLE rather than ERROR.
        try {
          count = Integer.valueOf(String.valueOf(val));
        } catch (Exception convEx) {
          return buildUnableResult(
            rule,
            'INVALID_SOQL_TEMPLATE',
            'Applicability SOQL aggregate value could not be read as a whole number. Use COUNT(Id) so the result is an integer.'
          );
        }
      } else {
        return buildUnableResult(
          rule,
          'INVALID_SOQL_TEMPLATE',
          'Applicability SOQL did not return one aggregate COUNT value.'
        );
      }

      Boolean applies = applyApplicabilityComparison(
        rule.ApplicabilityCountOperator__c,
        count,
        (Integer) rule.ApplicabilityCountThreshold__c
      );

      if (applies == null) {
        return buildUnableResult(
          rule,
          'INVALID_COMPARATOR',
          'Applicability comparison operator "' +
            rule.ApplicabilityCountOperator__c +
            '" is not recognized.'
        );
      }
      if (!applies) {
        return buildSkippedResult(rule);
      }
      return null;
    } catch (System.QueryException qex) {
      return buildUnableResult(rule, 'INVALID_SOQL_TEMPLATE', qex.getMessage());
    } catch (RecordHealthCheckEvaluatorException eex) {
      return buildUnableResult(rule, eex.reasonCode, eex.getMessage());
    } catch (RecordHealthCheckSoqlTemplate.TemplateException tex) {
      return buildUnableResult(rule, tex.reasonCode, tex.getMessage());
    } catch (Exception ex) {
      return buildUnableResult(rule, 'UNABLE_TO_EVALUATE', ex.getMessage());
    }
  }

  @TestVisible
  private Boolean applyApplicabilityComparison(
    String operator,
    Integer count,
    Integer threshold
  ) {
    if (operator == 'EQUALS')
      return count == threshold;
    if (operator == 'NOT_EQUALS')
      return count != threshold;
    if (operator == 'GREATER_THAN')
      return count > threshold;
    if (operator == 'GREATER_THAN_OR_EQUAL')
      return count >= threshold;
    if (operator == 'LESS_THAN')
      return count < threshold;
    if (operator == 'LESS_THAN_OR_EQUAL')
      return count <= threshold;
    return null;
  }

  // ─── Record loading ───────────────────────────────────────────────────────

  @TestVisible
  private SObject loadRecord(Id recordId, Record_Health_Check_Rule__mdt rule) {
    // WITH USER_MODE enforces FLS and CRUD for the running user.
    // Exceptions (inaccessible fields, object access denied) propagate to
    // doEvaluate, which maps them to RECORD_NOT_ACCESSIBLE.
    String objectName = RecordHealthCheckDescribeCache.objectApiName(recordId);
    Set<String> fields = collectRecordFields(rule, recordId.getSObjectType());
    List<String> fieldList = new List<String>(fields);
    fieldList.sort();

    String soql =
      'SELECT ' +
      String.join(fieldList, ', ') +
      ' FROM ' +
      objectName +
      ' WHERE Id = :recordId WITH USER_MODE LIMIT 1';
    // code-analyzer-suppress-next-line ApexSOQLInjection: object and field names are derived from Schema describe metadata; recordId is a bind variable and query runs WITH USER_MODE.
    List<SObject> rows = Database.query(soql);
    return rows.isEmpty() ? null : rows[0];
  }

  @TestVisible
  private Set<String> collectRecordFields(
    Record_Health_Check_Rule__mdt rule,
    Schema.SObjectType objectType
  ) {
    Set<String> fields = new Set<String>{ 'Id' };

    // Invalid display-message tokens are intentionally ignored: message rendering
    // turns them into blanks and they must never make record loading fail.
    addMergeFields(fields, objectType, rule.FailureMessage__c);
    addMergeFields(fields, objectType, rule.UnableToEvaluateMessage__c);
    // Remediation link fields may carry {!record.FieldName} tokens (including relationship
    // paths like {!record.Owner.ManagerId}); load their fields so the token resolves.
    addMergeFields(fields, objectType, rule.ActionUrl__c);
    addMergeFields(fields, objectType, rule.ActionLabel__c);
    addMergeFields(fields, objectType, rule.FixMessage__c);
    addMergeFields(fields, objectType, rule.SourceQuery__c);
    addMergeFields(fields, objectType, rule.ComparisonQuery__c);
    addMergeFields(fields, objectType, rule.ApplicabilityCountQuery__c);

    if (rule.EvaluationType__c == 'FORMULA') {
      addFormulaFields(fields, objectType, rule.PassConditionFormula__c);
      // Optional Found / Expected single-value formulas get the SAME calculated-field
      // dependency expansion as the pass/fail formula, so a balance check whose
      // operands are formula fields can display resolved numbers instead of UNABLE.
      addFormulaFields(fields, objectType, rule.DisplayFoundFormula__c);
      addFormulaFields(fields, objectType, rule.DisplayExpectedFormula__c);
    }
    if (rule.EvaluationType__c == 'QUERY') {
      // List checks read the single-value from FindInListFormula__c; RecordFormula compares to ExpectedRecordFormula__c.
      addFormulaFields(fields, objectType, rule.FindInListFormula__c);
      addFormulaFields(fields, objectType, rule.ExpectedRecordFormula__c);
      // Multi-row summary overrides may reference record fields alongside the
      // computed {!rhcResult.failedRecordCount}/{!rhcResult.totalRecordCount} count tokens.
      addMergeFields(fields, objectType, rule.DisplayFoundText__c);
      addMergeFields(fields, objectType, rule.DisplayExpectedText__c);
    }
    // CompareTwoQueries: both sides are SOQL — merge tokens already handled above
    if (rule.ApplicabilityMode__c == 'WHEN_FORMULA_TRUE') {
      addFormulaFields(fields, objectType, rule.ApplicabilityFormula__c);
    }

    return fields;
  }

  private void addMergeFields(
    Set<String> fields,
    Schema.SObjectType objectType,
    String template
  ) {
    if (String.isBlank(template)) {
      return;
    }

    for (
      String fieldPath : RecordHealthCheckTemplateService.recordPaths(
        template,
        RecordHealthCheckTemplateService.SURFACE_DISPLAY
      )
    ) {
      addReadableField(fields, objectType, fieldPath);
    }
  }

  private void addFormulaFields(
    Set<String> fields,
    Schema.SObjectType objectType,
    String formula
  ) {
    if (String.isBlank(formula)) {
      return;
    }
    // Walk the full dependency tree rooted at the record's own type. The visited
    // set is shared across the whole walk so a formula field reached by two paths
    // is only expanded once.
    expandFormulaDependencies(
      fields,
      objectType,
      objectType,
      formula,
      '',
      0,
      new Set<String>()
    );
  }

  /**
   * Adds every field a formula expression needs to the SELECT set — including the
   * transitive dependencies of any calculated (formula / roll-up) operand.
   * FormulaEval regenerates formula-field values from the in-memory SObject at
   * evaluation time, so a check like `FieldA__c > 0` — where `FieldA__c` is a
   * formula of `FieldX__c + FieldY__c` — needs FieldX__c and FieldY__c loaded
   * not just FieldA__c. Loading only the top-level name makes FormulaEval throw
   * "could not generate the requested field". This walks each referenced field's
   * own `getCalculatedFormula()` definition recursively until it reaches plain
   * source fields, for formulas of any return type (number, text, date, boolean
   * picklist) and any function — the expansion is driven by Schema, not by the
   * specific syntax used.
   * @param fields accumulating SELECT set (rooted at baseType)
   * @param baseType the record's SObjectType — the SELECT root; never changes
   * @param resolveType the type the CURRENT formula's tokens resolve against
   * (equals baseType at the top level, or a parent type when
   * recursing into a cross-object formula definition)
   * @param formula the formula text being scanned at this level
   * @param pathPrefix relationship path from baseType to resolveType, with a
   * trailing '.', or '' at the top level
   * @param depth current recursion depth (capped)
   * @param visited owner-qualified names of calculated fields already
   * expanded, to break cycles and re-convergent graphs
   */
  private void expandFormulaDependencies(
    Set<String> fields,
    Schema.SObjectType baseType,
    Schema.SObjectType resolveType,
    String formula,
    String pathPrefix,
    Integer depth,
    Set<String> visited
  ) {
    if (String.isBlank(formula) || depth > FORMULA_DEPENDENCY_DEPTH_CAP) {
      return;
    }

    for (String token : scanFormulaFieldTokens(formula)) {
      // Add the operand to the SELECT, rooted at the record's own type so the
      // path is valid in the SOQL even when we are deep inside a cross-object
      // formula definition.
      addReadableField(fields, baseType, pathPrefix + token);

      // If the operand is itself a calculated field, expand the fields ITS
      // definition references so the whole chain can be regenerated.
      FieldPathDescribe info = describeFieldPath(resolveType, token);
      if (
        info != null &&
        info.describe != null &&
        info.describe.isCalculated()
      ) {
        String nested = info.describe.getCalculatedFormula();
        String visitKey =
          String.valueOf(info.ownerType) +
          '.' +
          info.describe.getName();
        if (String.isNotBlank(nested) && visited.add(visitKey)) {
          expandFormulaDependencies(
            fields,
            baseType,
            info.ownerType,
            nested,
            pathPrefix + info.relationshipPrefix,
            depth + 1,
            visited
          );
        }
      }
    }
  }

  /**
   * Scans a formula expression for the field references it contains, in document
   * order and de-duplicated. Relationship paths (e.g. Parent.ShippingCity) are
   * captured whole first so a word-only scan does not split them into bare names;
   * single-segment field names follow. Formula function names and literals are
   * excluded, and double-quoted string literals are masked so a value such as
   * "example.com" is never mistaken for a relationship path.
   */
  @TestVisible
  private List<String> scanFormulaFieldTokens(String formula) {
    List<String> tokens = new List<String>();
    Set<String> seen = new Set<String>();
    if (String.isBlank(formula)) {
      return tokens;
    }
    String scannable = maskFormulaStringLiterals(formula);

    Matcher dotMatcher = PATTERN_DOT_PATH.matcher(scannable);
    while (dotMatcher.find()) {
      String path = dotMatcher.group(1);
      if (seen.add(path)) {
        tokens.add(path);
      }
    }

    Matcher wordMatcher = PATTERN_WORD.matcher(scannable);
    while (wordMatcher.find()) {
      String word = wordMatcher.group(0);
      if (FORMULA_FUNCTION_WORDS.contains(word.toUpperCase())) {
        continue;
      }
      if (seen.add(word)) {
        tokens.add(word);
      }
    }
    return tokens;
  }

  @TestVisible
  private String maskFormulaStringLiterals(String formula) {
    String masked = '';
    Boolean inQuote = false;
    for (Integer i = 0; i < formula.length(); i++) {
      String ch = formula.substring(i, i + 1);
      if (ch == '"' && (i == 0 || formula.substring(i - 1, i) != '\\')) {
        inQuote = !inQuote;
        masked += '"';
      } else {
        masked += inQuote ? ' ' : ch;
      }
    }
    return masked;
  }

  @TestVisible
  private void addReadableField(
    Set<String> fields,
    Schema.SObjectType objectType,
    String fieldPath
  ) {
    if (String.isBlank(fieldPath)) {
      return;
    }
    FieldPathDescribe info = describeFieldPath(objectType, fieldPath);
    if (info != null && info.describe != null && info.describe.isAccessible()) {
      fields.add(fieldPath);
    }
  }

  @TestVisible
  private void addReadableField(
    Set<String> fields,
    Map<String, Schema.SObjectField> fieldMap,
    String fieldName
  ) {
    if (String.isBlank(fieldName) || fieldName.contains('.')) {
      return;
    }
    Schema.SObjectField field = getFieldCaseInsensitive(fieldMap, fieldName);
    if (
      field != null &&
      RecordHealthCheckDescribeCache.describeField(field).isAccessible()
    ) {
      fields.add(fieldName);
    }
  }

  /**
   * Resolves a (possibly relationship-qualified) field path against a starting
   * type, returning the terminal field's describe plus the owning type and the
   * relationship prefix needed to root nested dependencies back at the path.
   * Lookups are case-insensitive (SCAN: a token typed as `website` or
   * `BILLINGCITY` still resolves against the lowercase Schema field map).
   * Returns null if any segment is missing or an intermediate relationship field
   * is inaccessible — the caller then simply skips the field.
   */
  @TestVisible
  private FieldPathDescribe describeFieldPath(
    Schema.SObjectType objectType,
    String fieldPath
  ) {
    if (objectType == null || String.isBlank(fieldPath)) {
      return null;
    }
    List<String> parts = fieldPath.split('\\.');
    Schema.SObjectType currentType = objectType;
    List<String> relationshipParts = new List<String>();
    for (Integer i = 0; i < parts.size(); i++) {
      Map<String, Schema.SObjectField> currentFields = RecordHealthCheckDescribeCache.fieldMap(
        currentType
      );
      if (i == parts.size() - 1) {
        Schema.SObjectField terminal = getFieldCaseInsensitive(
          currentFields,
          parts[i]
        );
        if (terminal == null) {
          return null;
        }
        FieldPathDescribe out = new FieldPathDescribe();
        out.describe = RecordHealthCheckDescribeCache.describeField(terminal);
        out.ownerType = currentType;
        out.relationshipPrefix = relationshipParts.isEmpty()
          ? ''
          : String.join(relationshipParts, '.') + '.';
        return out;
      }

      Schema.SObjectField relationshipField = findRelationshipField(
        currentFields,
        parts[i]
      );
      if (
        relationshipField == null ||
        !RecordHealthCheckDescribeCache.describeField(relationshipField)
          .isAccessible()
      ) {
        return null;
      }
      List<Schema.SObjectType> referenceTypes = RecordHealthCheckDescribeCache.describeField(
          relationshipField
        )
        .getReferenceTo();
      if (referenceTypes.isEmpty()) {
        return null;
      }
      relationshipParts.add(parts[i]);
      currentType = referenceTypes[0];
    }
    return null;
  }

  /**
   * Case-insensitive field lookup against a Schema field map (whose keys are
   * lowercased), so admin-authored API names resolve regardless of typed case.
   */
  private Schema.SObjectField getFieldCaseInsensitive(
    Map<String, Schema.SObjectField> fieldMap,
    String name
  ) {
    if (fieldMap.containsKey(name)) {
      return fieldMap.get(name);
    }
    Schema.SObjectField lower = fieldMap.get(name.toLowerCase());
    if (lower != null) {
      return lower;
    }
    for (String key : fieldMap.keySet()) {
      if (key.equalsIgnoreCase(name)) {
        return fieldMap.get(key);
      }
    }
    return null;
  }

  /**
   * Finds the field whose relationship name matches `relName` (case-insensitive)
   * e.g. `Parent` → the ParentId lookup, `Account__r` → the Account__c lookup.
   */
  private Schema.SObjectField findRelationshipField(
    Map<String, Schema.SObjectField> fieldMap,
    String relName
  ) {
    for (Schema.SObjectField candidate : fieldMap.values()) {
      Schema.DescribeFieldResult description = RecordHealthCheckDescribeCache.describeField(
        candidate
      );
      if (
        description.getRelationshipName() != null &&
        description.getRelationshipName().equalsIgnoreCase(relName)
      ) {
        return candidate;
      }
    }
    return null;
  }

  /** Terminal-field describe plus the context needed to root nested dependencies. */
  @TestVisible
  private class FieldPathDescribe {
    Schema.DescribeFieldResult describe;
    Schema.SObjectType ownerType;
    String relationshipPrefix;
  }

  // ─── Result builders ──────────────────────────────────────────────────────

  @TestVisible
  private RecordHealthCheckResult buildSkippedResult(
    Record_Health_Check_Rule__mdt rule
  ) {
    RecordHealthCheckResult r = new RecordHealthCheckResult();
    r.checkDeveloperName = rule.DeveloperName;
    r.label = rule.CheckTitle__c;
    r.priority = rule.EvaluationOrder__c;
    r.evaluatorType = rule.EvaluationType__c;
    r.status = 'SKIPPED';
    r.reasonCode = 'APPLICABILITY_NOT_MET';
    if (rule.ApplicabilityMode__c == 'WHEN_FORMULA_TRUE') {
      r.message = 'This check does not apply because its formula applicability condition evaluated to false.';
    } else if (rule.ApplicabilityMode__c == 'WHEN_COUNT_QUERY_MATCHES') {
      r.message = 'This check does not apply because its SOQL applicability query did not meet the configured threshold.';
    } else {
      r.message = 'This check does not apply to the current record.';
    }
    return r;
  }

  /**
   * Resolves merge tokens on the final result message. On FAIL, a non-blank
   * evaluator message (for example a custom Apex plugin message naming specific
   * records) is preserved; FailureMessage__c is the fallback when the
   * evaluator left message blank. Every other non-PASS status carries a
   * UnableToEvaluateMessage__c or skip template the evaluator already placed on
   * the result. A bad token collapses to empty string and never changes status.
   */
  @TestVisible
  private void resolveEvalResultMessage(
    RecordHealthCheckResult evalResult,
    Record_Health_Check_Rule__mdt rule,
    SObject record
  ) {
    if (evalResult == null) {
      return;
    }
    if (evalResult.status == 'FAIL') {
      if (String.isBlank(evalResult.message)) {
        evalResult.message = String.isNotBlank(rule.FailureMessage__c)
          ? formulaEvaluator.resolveMergeFields(
              rule.FailureMessage__c,
              record,
              rule,
              evalResult,
              true
            )
          : 'Check failed.';
      } else {
        resolveResultMessage(evalResult, rule, record);
      }
      return;
    }
    resolveResultMessage(evalResult, rule, record);
  }

  private void resolveResultMessage(
    RecordHealthCheckResult result,
    Record_Health_Check_Rule__mdt rule,
    SObject record
  ) {
    if (result != null && String.isNotBlank(result.message)) {
      result.message = formulaEvaluator.resolveMergeFields(
        result.message,
        record,
        rule,
        result,
        true
      );
    }
  }

  /**
   * Populates the read-only remediation link on a FAIL result from the rule's
   * PrimaryAction / FixInstructions fields. The URL is token-resolved against the
   * record (with each substituted value URL-encoded) and then sanitized; an
   * unsafe or over-length URL is dropped rather than surfaced as an href, but any
   * FixInstructions still render so the row keeps its guidance. Non-FAIL statuses
   * carry no link — remediation is meaningless on a pass and non-determinate
   * statuses may lack a loaded record to resolve tokens against.
   */
  @TestVisible
  private void populateRemediationAction(
    RecordHealthCheckResult result,
    Record_Health_Check_Rule__mdt rule,
    SObject record
  ) {
    if (result == null || result.status != 'FAIL') {
      return;
    }

    // Instructions (and an optional label) can stand on their own even without a
    // link, so resolve them regardless of URL validity.
    result.fixInstructions = String.isBlank(rule.FixMessage__c)
      ? null
      : formulaEvaluator.resolveMergeFields(
          rule.FixMessage__c,
          record,
          rule,
          result,
          true
        );

    if (String.isBlank(rule.ActionUrl__c)) {
      return;
    }

    String resolvedUrl = formulaEvaluator.resolveUrlMergeFields(
      rule.ActionUrl__c,
      record,
      rule,
      result
    );
    String safeUrl = sanitizeActionUrl(resolvedUrl);
    if (safeUrl == null) {
      // Suppress the link but leave a breadcrumb in the admin-only detail channel.
      if (String.isBlank(result.detailMessage)) {
        result.detailMessage =
          'Remediation link suppressed: resolved URL failed validation (scheme or length). Resolved value: ' +
          resolvedUrl;
      }
      return;
    }

    result.actionUrl = safeUrl;
    result.actionLabel = String.isBlank(rule.ActionLabel__c)
      ? 'Fix this'
      : formulaEvaluator.resolveMergeFields(
          rule.ActionLabel__c,
          record,
          rule,
          result,
          true
        );
  }

  /**
   * Returns a URL safe to render as an href, or null if it must be rejected.
   * Allowed: a same-org relative path (single leading slash, not protocol-relative
   * "//") or an absolute https:// URL. Everything else — javascript:, data:,
   * plain http:, protocol-relative, whitespace-obfuscated schemes, or anything
   * over the 2000-char field ceiling — is rejected.
   */
  @TestVisible
  private String sanitizeActionUrl(String url) {
    if (String.isBlank(url)) {
      return null;
    }
    String trimmed = url.trim();
    if (trimmed.length() > 2000) {
      return null;
    }
    // Control characters can smuggle a scheme past the check (e.g. "java\nscript:").
    if (
      trimmed.contains('\n') ||
      trimmed.contains('\r') ||
      trimmed.contains('\t')
    ) {
      return null;
    }
    if (trimmed.contains('\\')) {
      return null;
    }
    if (trimmed.startsWith('//')) {
      return null; // protocol-relative → resolves off-org
    }
    if (trimmed.startsWith('/')) {
      return trimmed; // same-org relative path
    }
    if (trimmed.toLowerCase().startsWith('https://')) {
      return trimmed;
    }
    return null;
  }

  @TestVisible
  private RecordHealthCheckResult buildUnableResult(
    Record_Health_Check_Rule__mdt rule,
    String reasonCode,
    String detail
  ) {
    RecordHealthCheckResult r = new RecordHealthCheckResult();
    r.checkDeveloperName = rule.DeveloperName;
    r.label = rule.CheckTitle__c;
    r.priority = rule.EvaluationOrder__c;
    r.evaluatorType = rule.EvaluationType__c;
    r.status = 'UNABLE_TO_EVALUATE';
    r.reasonCode = reasonCode;
    r.detailMessage = detail;
    r.message = String.isNotBlank(rule.UnableToEvaluateMessage__c)
      ? rule.UnableToEvaluateMessage__c
      : 'This check could not be evaluated. Contact your administrator.';
    return r;
  }
}
